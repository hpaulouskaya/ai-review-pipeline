.env
# Local .env variants (.env.local, .env.production, ...). A committed
# template, if one is ever added, must be named .env.example.
.env.*
!.env.example

.venv/

__pycache__/

.pytest_cache/

.DS_Store

# Local Claude Code MCP registration: contains machine-specific absolute
# paths. Committed template: .mcp.json.example
.mcp.json

# Local Claude Code settings (permissions, machine-specific paths). Ignored
# here so it does not depend on each developer's global Git configuration.
.claude/settings.local.json

# Generated run artifacts: ignore everything except the three
# verified M04 reference artifacts listed below.
runs/*
!runs/2026-11-15_15-36-16/
runs/2026-11-15_15-36-16/*
!runs/2026-11-15_15-36-16/predictions.json
!runs/2026-11-15_15-36-16/routing_results.json
!runs/2026-11-15_15-36-16/routing_config_used.json
